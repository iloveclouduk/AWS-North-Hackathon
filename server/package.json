{
  "name": "aws-city-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc",
    "test": "vitest run",
    "build:bundle": "esbuild src/main.ts --bundle --platform=node --target=node24 --format=esm --sourcemap --outfile=dist/main.js --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\""
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.33.8",
    "@anthropic-ai/sdk": "^0.128.0",
    "@aws-sdk/client-apigatewayv2": "^3.1140.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1140.0",
    "@aws-sdk/client-dynamodb": "^3.1140.0",
    "@aws-sdk/client-ec2": "^3.1140.0",
    "@aws-sdk/client-lambda": "^3.1140.0",
    "@aws-sdk/client-rds": "^3.1140.0",
    "@aws-sdk/client-s3": "^3.1140.0",
    "@aws-sdk/client-ssm": "^3.1140.0",
    "@aws-sdk/client-sts": "^3.1140.0",
    "@aws-sdk/credential-providers": "^3.1140.0",
    "@aws-sdk/lib-dynamodb": "^3.1140.0",
    "@aws-sdk/s3-presigned-post": "^3.1140.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "aws-jwt-verify": "^5.2.1",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/ws": "^8.18.1",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^5.0.2"
  }
}
