# Which backend the extension talks to:
#   mock      scripted agents in the browser (default, no AWS needed)
#   aws       the local server on your machine (cd server && npm start prints these values)
#   hosted    the production server deployed by infra/ (players sign in with Cognito)
#   agentcore Strands swarm on Bedrock AgentCore Runtime (branch parked/agentcore-backend)
WXT_BACKEND=mock

# aws (local) and hosted: the server's URLs (hosted: the Service stack's ApiUrl / WsUrl outputs)
WXT_AWS_WS_URL=ws://127.0.0.1:8787/ws
WXT_AWS_API_URL=http://127.0.0.1:8787

# hosted (Auth stack outputs CognitoDomain / CognitoClientId) and agentcore
WXT_COGNITO_DOMAIN=
WXT_COGNITO_CLIENT_ID=

# agentcore only
WXT_AGENTCORE_REGION=us-west-2
WXT_AGENTCORE_RUNTIME_ARN=
