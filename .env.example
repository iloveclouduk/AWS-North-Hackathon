# mock = scripted fake agents in the browser (default). agentcore = the Strands swarm in backend/.
WXT_BACKEND=mock
# From `cdk deploy` outputs (backend/infra):
WXT_AGENTCORE_REGION=us-west-2
WXT_AGENTCORE_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-west-2:123456789012:runtime/aws_city-XXXX
WXT_COGNITO_DOMAIN=https://aws-city-XXXX.auth.us-west-2.amazoncognito.com
WXT_COGNITO_CLIENT_ID=
