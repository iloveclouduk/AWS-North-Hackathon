# Which backend the extension talks to:
#   mock      scripted agents in the browser (default, no AWS needed)
#   aws       the local server on your machine (cd server && npm start prints these values)
#   hosted    the production server deployed by infra/ (players sign in with Cognito)
WXT_BACKEND=mock

# aws (local) and hosted: the server's URLs (hosted: the Service stack's ApiUrl / WsUrl outputs)
WXT_AWS_WS_URL=ws://127.0.0.1:8787/ws
WXT_AWS_API_URL=http://127.0.0.1:8787

# hosted (Auth stack outputs CognitoDomain / CognitoClientId)
WXT_COGNITO_DOMAIN=
WXT_COGNITO_CLIENT_ID=

# Safari only (it has no identity API): the sign-in relay page Cognito redirects to (infra/auth-relay, deployed by infra/)
WXT_COGNITO_REDIRECT_URL=

# aws (local), browsers whose extension origin can't be pinned (Firefox, Safari): the server's token.
# npm run live sets it for you.
WXT_AWS_TOKEN=

# false hides the official AWS Architecture Icons everywhere (UI and building signs)
WXT_OFFICIAL_ICONS=true

# Release builds for the Chrome Web Store set true: the store assigns its own extension id, and the awsCity DevTools hooks are left out
WXT_STORE_BUILD=false
