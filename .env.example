# mock = scripted fake agents in the browser (default). aws = real backend below.
WXT_BACKEND=mock
# API Gateway WebSocket stage URL, e.g. wss://abc123.execute-api.eu-west-2.amazonaws.com/prod
WXT_AWS_WS_URL=
# API Gateway REST (HTTP API) base URL, e.g. https://xyz789.execute-api.eu-west-2.amazonaws.com
WXT_AWS_API_URL=
