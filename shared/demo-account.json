  "findings": [
    {
      "ruleId": "dynamodb-no-pitr",
      "resource": "arn:aws:dynamodb:us-west-2:123456789012:table/city-quest-library",
      "explain": "If someone deletes items by mistake, or a script overwrites them, the table only has what's in it now. With point-in-time recovery on, you can copy it into a new table as it was at any second in its recovery window (up to 35 days). The city built this table, so once you've taught me I can turn it on for you."
    },
    {
      "ruleId": "s3-public-access",
      "resource": "arn:aws:s3:::team-photo-share",
      "explain": "Today the bucket is private, but nothing stops a policy or ACL from opening it up. One wrong click and every photo could be downloaded by anyone. Block Public Access is a safety catch that wins over any bucket policy or ACL that tries to make it public. The city didn't build this bucket, so you'll type its name to approve the fix."
    },
    {
      "ruleId": "sg-world-admin",
      "resource": "arn:aws:ec2:us-west-2:123456789012:security-group/sg-0c1d2e3f4a5b6c7d8",
      "explain": "Bots try passwords on open SSH and RDP ports all day. If one gets in, it controls the server. Session Manager lets you log in without opening any port. The city didn't build this security group, so you'll type its name to approve."
    },
    {
      "ruleId": "lambda-old-runtime",
      "resource": "arn:aws:lambda:us-west-2:123456789012:function:legacy-report-job",
      "explain": "It still runs today, but it stops getting security fixes, and later you can't change its code until you move it to a newer runtime. To fix it: test the code on a newer runtime, then change the runtime in the function's settings. I can't change code for you, so this one is yours."
    },
    {
      "ruleId": "ebs-unattached",
      "resource": "arn:aws:ec2:us-west-2:123456789012:volume/vol-0aa11bb22cc33dd44",
      "explain": "Nothing reads or writes this disk, but it's billed every month. If you still need the data, take a snapshot first (cheaper to keep), then delete the volume in the EC2 console. I only explain this one, because deleting can't be undone."
    },
    {
      "ruleId": "ec2-previous-generation",
      "resource": "arn:aws:ec2:us-west-2:123456789012:instance/i-0b2c3d4e5f6a70819",
      "explain": "Newer instance types give better performance, often for less money. Moving means stopping the server, changing its type and starting it again. Older servers may need new drivers first, so test and pick a quiet moment. I'll leave that to you."
    },
    {
      "ruleId": "ec2-graviton-candidate",
      "resource": "arn:aws:ec2:us-west-2:123456789012:instance/i-0c3d4e5f6a7b80910",
      "explain": "Graviton servers do the same work with less energy and often cost less. Your software has to run on Arm, so test it on a Graviton instance first. This is a change you make, not me."
    },
    {
      "ruleId": "ec2-imdsv1",
      "resource": "arn:aws:ec2:us-west-2:123456789012:instance/i-0a1b2c3d4e5f60718",
      "explain": "If an attacker tricks software on the server into fetching a URL for them, IMDSv1 hands over the temporary AWS keys of the server's role. IMDSv2 needs a token first, which stops most of those tricks. Check your software supports IMDSv2 before you require it. This server wasn't built by the city, so you'll type its name to approve."
    },
    {
      "ruleId": "ebs-default-encryption",
      "resource": "region",
      "name": "ebs-default-encryption-us-west-2",
      "explain": "Anyone can create an unencrypted disk today without noticing. Turning on encryption by default means every new disk in this Region is encrypted. Disks you already have stay as they are, and the default key has no monthly fee. It's an account-wide setting, so you'll type its name to approve."
    }
  ],
