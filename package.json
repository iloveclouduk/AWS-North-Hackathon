{
  "name": "aws-city",
  "description": "AWS City — learn AWS by exploring a pixel-art city of agents (Chrome extension)",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare",
    "assets": "bash scripts/fetch-assets.sh",
    "smoke": "wxt build && node scripts/smoke.mjs",
    "check": "tsc --noEmit && vitest run",
    "open": "wxt build && node scripts/open.mjs",
    "art": "python3 art/pack/import_agentic.py && python3 art/characters/aws_city.py && python3 art/tiles/generate_tiles.py"
  },
  "dependencies": {
    "phaser": "^4.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wxt": "^0.21.4"
  }
}
