{
  "name": "aws-city",
  "description": "AWS City — learn AWS by exploring a pixel-art city of agents (Chrome, Edge, Firefox and Safari extension)",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:safari": "wxt build -b safari",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare",
    "assets": "bash scripts/fetch-assets.sh",
    "smoke": "wxt build && node scripts/smoke.mjs",
    "check": "tsc --noEmit && vitest run",
    "lint": "eslint .",
    "open": "wxt build && node scripts/open.mjs",
    "art": "python3 art/pack/import_agentic.py && python3 art/characters/aws_city.py && python3 art/characters/crowd_small.py && python3 art/tiles/generate_tiles.py",
    "smoke:copilot": "wxt build && node scripts/smoke-copilot.mjs",
    "live": "node scripts/live.mjs",
    "icons": "node scripts/fetch-aws-icons.mjs",
    "prices": "node scripts/fetch-prices.mjs",
    "region-facts": "node scripts/fetch-region-facts.mjs",
    "setup": "node scripts/launcher/require-node.mjs && npm --prefix infra ci --no-audit --no-fund --loglevel=error && node infra/setup/setup.mjs",
    "lint:firefox": "wxt build -b firefox && web-ext lint -s .output/firefox-mv3",
    "safari:xcode": "wxt build -b safari && xcrun safari-web-extension-converter .output/safari-mv3 --project-location .cache/safari --app-name \"AWS City\" --bundle-identifier dev.awscity.AWS-City --macos-only --no-prompt --force"
  },
  "dependencies": {
    "phaser": "^4.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@clack/prompts": "^1.8.1",
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "picocolors": "^1.1.1",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "web-ext": "^10.7.0",
    "wxt": "^0.21.4"
  }
}
